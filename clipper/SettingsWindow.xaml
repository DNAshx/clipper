<Window x:Class="clipper.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipper AI — настройки" Width="650" Height="730" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#F5F6FA" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Дайте скрепке голос" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Каждая реплика создаётся выбранной LLM." Foreground="#555" Margin="0,6,0,0"/>
        </StackPanel>
        <TabControl Grid.Row="1" Background="White" Padding="12">
            <TabItem Header="Подключение">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Провайдер"/>
                        <ComboBox x:Name="ProviderBox" SelectionChanged="Provider_Changed"/>
                        <TextBlock Text="API-ключ"/>
                        <PasswordBox x:Name="KeyBox" Padding="8" Margin="0,4,0,8" PasswordChanged="Key_Changed"/>
                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="Получить API-ключ ↗" Click="OpenKeyPage_Click"/>
                            <Button Content="Удалить ключ" Click="RemoveKey_Click"/>
                        </WrapPanel>
                        <StackPanel x:Name="WorkspacePanel" Visibility="Collapsed">
                            <TextBlock Text="Claude Workspace ID (необязательно)"/>
                            <TextBox x:Name="WorkspaceBox" TextChanged="Workspace_Changed" MaxLength="128"/>
                            <TextBlock Text="Для ключа организации единственный workspace определится автоматически. Если их несколько, укажите ID из Claude Console."
                                       TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,12"/>
                        </StackPanel>
                        <TextBlock Text="Модель (можно ввести собственный ID)"/>
                        <ComboBox x:Name="ModelBox" IsEditable="True"/>
                        <TextBlock x:Name="ModelsStatusText" Text="Встроенный список моделей. Подключите ключ для загрузки из API."
                                   TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"/>
                        <TextBlock x:Name="RecommendationText" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,16">
                            <Button Content="Выбрать рекомендуемую" Click="Recommended_Click"/>
                            <Button x:Name="RefreshModelsButton" Content="Обновить модели" Click="RefreshModels_Click"/>
                        </WrapPanel>
                        <TextBlock Text="Язык реплик"/>
                        <ComboBox x:Name="LanguageBox" IsEditable="True">
                            <ComboBoxItem Content="Russian"/>
                            <ComboBoxItem Content="English"/>
                            <ComboBoxItem Content="Spanish"/>
                        </ComboBox>
                        <CheckBox x:Name="ContextBox" Content="Передавать LLM название приложения и заголовок окна"
                                  Margin="0,8"/>
                        <CheckBox x:Name="AutomaticBox" Content="Автоматически реагировать на смену приложения"
                                  Margin="0,8"/>
                        <TextBlock Text="Автоматические реакции требуют передачи контекста. Заголовки могут содержать личные данные. Скриншоты и содержимое файлов не отправляются."
                                   TextWrapping="Wrap" Foreground="#555" Margin="0,4,0,16"/>
                        <Border Background="#F0F3FA" Padding="12" CornerRadius="8">
                            <TextBlock Text="API-ключи шифруются для вашей учётной записи Windows. Используется API провайдера; вход через подписку ChatGPT, Claude или Gemini здесь не реализован."
                                       TextWrapping="Wrap" Foreground="#444"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Промпты">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Характер скрепки (системный промпт)" FontWeight="SemiBold"/>
                        <TextBox x:Name="SystemPromptBox" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="180" VerticalScrollBarVisibility="Auto" MaxLength="8000"/>
                        <StackPanel x:Name="EventPromptPanel"/>
                        <Button Content="Восстановить стандартные промпты" Click="ResetPrompts_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" x:Name="StatusText" TextWrapping="Wrap" Foreground="#444" Margin="0,14"/>
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button x:Name="TestButton" Content="Проверить подключение" Click="Test_Click"/>
            <Button Content="Отмена" IsCancel="True"/>
            <Button Content="Сохранить" Click="Save_Click" Margin="0" FontWeight="SemiBold"/>
        </WrapPanel>
    </Grid>
</Window>
