<Window x:Class="clipper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="280"
        Height="520"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        Closing="Window_Closing"
        MouseRightButtonUp="Window_MouseRightButtonUp">

    <Grid>

        <Border
            x:Name="SpeechBubble"
            Background="#FFF8E79A"
            BorderBrush="#AA8A7A3A"
            BorderThickness="1"
            CornerRadius="18"
            Padding="12"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Width="250"
            Visibility="Collapsed"
            Opacity="1">

            <TextBlock
                x:Name="SpeechText"
                Text=""
                Foreground="Black"
                FontFamily="Comic Sans MS"
                FontSize="16"
                FontWeight="Bold"
                TextWrapping="Wrap"
                TextAlignment="Center"/>
        </Border>

        <Border x:Name="StatusPanel" Background="#EEFFFFFF" CornerRadius="8" Padding="8"
                Width="250" VerticalAlignment="Bottom" Margin="0,0,0,265" Visibility="Collapsed">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontFamily="Segoe UI" FontSize="12"
                       Foreground="#555555" TextAlignment="Center"/>
        </Border>

        <Viewbox x:Name="CharacterView" Width="240" Height="260" Stretch="Uniform"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1"
                 MouseLeftButtonDown="Clippy_MouseLeftButtonDown"
                 MouseLeftButtonUp="Clippy_MouseLeftButtonUp" MouseMove="Clippy_MouseMove">
            <Viewbox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ClippyScale"
                            ScaleX="1"
                            ScaleY="1"/>

                    <RotateTransform x:Name="ClippyRotate"
                             Angle="0"/>

                    <TranslateTransform x:Name="ClippyTranslate"
                                Y="0"/>
                </TransformGroup>
            </Viewbox.RenderTransform>
            <Grid x:Name="CharacterCanvas" Width="1254" Height="1254" Background="Transparent">
                <Canvas x:Name="EyesCanvas" IsHitTestVisible="False"/>
                <Image x:Name="ClippyImage" Stretch="Fill"/>
            </Grid>
        </Viewbox>

    </Grid>
</Window>
