<Window x:Class="clipper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="280"
        Height="340"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonUp="Window_MouseRightButtonUp">

    <Grid>

        <Border
            x:Name="SpeechBubble"
            Background="#FFF8E79A"
            BorderBrush="#AA8A7A3A"
            BorderThickness="1"
            CornerRadius="18"
            Padding="12"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Width="250"
            Opacity="1">

            <TextBlock
                x:Name="SpeechText"
                Text="Похоже, ты пытаешься работать."
                Foreground="Black"
                FontFamily="Comic Sans MS"
                FontSize="16"
                FontWeight="Bold"
                TextWrapping="Wrap"
                TextAlignment="Center"/>
        </Border>

        <Viewbox Width="240" Height="260"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 RenderTransformOrigin="0.5,1">
            <Viewbox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ClippyScale" ScaleX="1" ScaleY="1"/>
                    <RotateTransform x:Name="ClippyRotate" Angle="0"/>
                    <TranslateTransform x:Name="ClippyTranslate" Y="0"/>
                </TransformGroup>
            </Viewbox.RenderTransform>
            <Grid x:Name="CharacterCanvas" Width="1254" Height="1254">
                <!-- База закрывает края глаз; зрачки остаются внутри глазниц. -->
                <Canvas x:Name="EyesCanvas" IsHitTestVisible="False"/>
                <Image x:Name="ClippyImage" Stretch="Fill"/>
            </Grid>
        </Viewbox>

    </Grid>
</Window>